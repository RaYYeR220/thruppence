# Local development. Copy to .env and fill in; never commit .env.
PORT=8791
DEV=1
DB_PATH=thruppence.db
NETWORK_ID=-3
EXPLORER=https://testnet.tonviewer.com

# Telegram bot (leave empty to run with the offline stand-in)
BOT_TOKEN=
PUBLIC_URL=

# Language model and speech-to-text (Venice, OpenAI-compatible)
VENICE_API_KEY=
LLM_MODEL=claude-haiku-5-5
STT_MODEL=openai/whisper-large-v3

# TON testnet RPC (toncenter-compatible); without a key, keep TON_RPS at 1
TONCENTER_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=
TON_RPS=1

# Public try-it demo: a capped testnet wallet and the key that stands in for a phone
DEMO_OWNER=
DEMO_WALLET=
DEMO_EXT=
DEMO_JAR=
DEMO_DEVICE_SEED=
